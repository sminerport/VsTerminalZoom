<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidVsTerminalZoomPackage">
    <Groups>
      <Group guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <!-- CanonicalName starts with "." so Tools > Options > Environment > Keyboard lists the
           command as Terminal.FontZoomIn instead of Tools.TerminalFontZoomIn. -->
      <Button guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalFontZoomIn" priority="0x0100" type="Button">
        <Parent guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" />
        <Strings>
          <ButtonText>Terminal Font Zoom &amp;In</ButtonText>
          <CanonicalName>.Terminal.FontZoomIn</CanonicalName>
          <LocCanonicalName>.Terminal.FontZoomIn</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalFontZoomOut" priority="0x0101" type="Button">
        <Parent guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" />
        <Strings>
          <ButtonText>Terminal Font Zoom &amp;Out</ButtonText>
          <CanonicalName>.Terminal.FontZoomOut</CanonicalName>
          <LocCanonicalName>.Terminal.FontZoomOut</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalFontZoomReset" priority="0x0102" type="Button">
        <Parent guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" />
        <Strings>
          <ButtonText>Terminal Font Zoom &amp;Reset</ButtonText>
          <CanonicalName>.Terminal.FontZoomReset</CanonicalName>
          <LocCanonicalName>.Terminal.FontZoomReset</LocCanonicalName>
        </Strings>
      </Button>
      <!-- Sends ESC CR to the focused terminal (what VS Code's /terminal-setup binds Shift+Enter to), so
           Claude Code inserts a newline instead of submitting. Hidden from menus; bindable in Options > Keyboard. -->
      <Button guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalSendShiftEnter" priority="0x0103" type="Button">
        <Parent guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <Strings>
          <ButtonText>Terminal Send Shift+Enter as Newline</ButtonText>
          <CanonicalName>.Terminal.SendShiftEnter</CanonicalName>
          <LocCanonicalName>.Terminal.SendShiftEnter</LocCanonicalName>
        </Strings>
      </Button>
      <!-- Opens a new terminal with the default profile (VS Code: workbench.action.terminal.new, Ctrl+Shift+`).
           Visual Studio has no bindable command for the Terminal window's "+" button. -->
      <Button guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalNew" priority="0x0104" type="Button">
        <Parent guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" />
        <Strings>
          <ButtonText>Terminal &amp;New (Default Profile)</ButtonText>
          <CanonicalName>.Terminal.New</CanonicalName>
          <LocCanonicalName>.Terminal.New</LocCanonicalName>
        </Strings>
      </Button>
      <!-- Closes the focused terminal (VS Code: workbench.action.terminal.kill, Ctrl+Shift+W) by running
           Window.CloseToolWindow on it; closing the terminal pane ends its shell. -->
      <Button guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalClose" priority="0x0105" type="Button">
        <Parent guid="guidVsTerminalZoomCmdSet" id="TerminalZoomGroup" />
        <Strings>
          <ButtonText>Terminal &amp;Close</ButtonText>
          <CanonicalName>.Terminal.Close</CanonicalName>
          <LocCanonicalName>.Terminal.Close</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- Zoom, Shift+Enter and Close are scoped to the Terminal tool window (same scope Terminal.Copy / Terminal.Paste
       use), which mirrors VS Code's "when": "terminalFocus"; in that scope they win over Global bindings such as
       Ctrl+Shift+W = Window.CloseDocumentWindow. Terminal.New is Global (guidVSStd97), like VS Code's default
       Ctrl+Shift+` binding, so it works from the editor too. VK_OEM_3 is the ` / ~ key on US layouts. -->
  <KeyBindings>
    <KeyBinding guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalFontZoomIn" editor="guidTerminalScope" key1="VK_OEM_PLUS" mod1="Control Alt" />
    <KeyBinding guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalFontZoomOut" editor="guidTerminalScope" key1="VK_OEM_MINUS" mod1="Control Alt" />
    <KeyBinding guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalFontZoomReset" editor="guidTerminalScope" key1="0" mod1="Control Alt" />
    <KeyBinding guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalSendShiftEnter" editor="guidTerminalScope" key1="VK_RETURN" mod1="Shift" />
    <KeyBinding guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalNew" editor="guidVSStd97" key1="VK_OEM_3" mod1="Control Shift" />
    <KeyBinding guid="guidVsTerminalZoomCmdSet" id="cmdidTerminalClose" editor="guidTerminalScope" key1="W" mod1="Control Shift" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidVsTerminalZoomPackage" value="{6f3b9a21-8c4d-4e07-9b5a-2d1e7c8f0a43}" />
    <GuidSymbol name="guidTerminalScope" value="{d212f56b-c48a-434c-a121-1c5d80b59b9f}" />
    <GuidSymbol name="guidVsTerminalZoomCmdSet" value="{c2a7e514-0b9d-4f36-8e61-7a3d5b9c4e28}">
      <IDSymbol name="TerminalZoomGroup" value="0x1020" />
      <IDSymbol name="cmdidTerminalFontZoomIn" value="0x0100" />
      <IDSymbol name="cmdidTerminalFontZoomOut" value="0x0101" />
      <IDSymbol name="cmdidTerminalFontZoomReset" value="0x0102" />
      <IDSymbol name="cmdidTerminalSendShiftEnter" value="0x0103" />
      <IDSymbol name="cmdidTerminalNew" value="0x0104" />
      <IDSymbol name="cmdidTerminalClose" value="0x0105" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
